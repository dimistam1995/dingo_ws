[Unit]
Description=Fresh Clearpath Dingo Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
KillMode=control-group
TimeoutStopSec=15
WorkingDirectory=/home/dimi/dingo_ws
Environment=HOME=/home/dimi
Environment=PYTHONUNBUFFERED=1
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ExecStart=/usr/bin/env -i HOME=/home/dimi PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET RMW_IMPLEMENTATION=rmw_fastrtps_cpp RMW_FASTRTPS_USE_SHM=0 /bin/bash -lc '. /opt/ros/jazzy/setup.bash && . /home/dimi/dingo_ws/install/setup.bash && exec /usr/bin/python3 /home/dimi/dingo_ws/install/dingo_bringup/lib/dingo_bringup/dingo_dashboard.py --ros-args -p host:=0.0.0.0 -p port:=8090 -p auto_start_map:=dingo_map -p auto_localize:=true -p auto_relocalize:=true -p autonomous_navigation_bypass_bt_quality:=true -p bt_quality_normal_priority:=252'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
